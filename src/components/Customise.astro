---
import { t, type Lang } from '../i18n';

/** "Make it yours": one icon per customisation topic, in the order of the copy items. */
const { lang } = Astro.props as { lang: Lang };
const d = t(lang).products.customise;

// materials, colourways, logo & branding, padding & fit, closure, packaging
const icons = [
  '<path d="M12 3 3 7.5l9 4.5 9-4.5L12 3z"/><path d="m3 12 9 4.5 9-4.5"/><path d="m3 16.5 9 4.5 9-4.5"/>',
  '<rect x="3" y="3" width="7" height="18"/><rect x="10" y="3" width="7" height="18" transform="rotate(12 13.5 12)"/><circle cx="6.5" cy="17" r="1.2"/>',
  '<path d="M3 12V4h8l10 10-8 8L3 12z"/><circle cx="7.5" cy="8.5" r="1.5"/>',
  '<path d="M12 3 4 6v6c0 4.5 3.4 8.2 8 9 4.6-.8 8-4.5 8-9V6l-8-3z"/><path d="M8.5 12h7M8.5 15h7"/>',
  '<rect x="3" y="7" width="18" height="10" rx="1"/><path d="M8 7v10M16 7v10M8 12h8"/>',
  '<path d="M3 7.5 12 3l9 4.5v9L12 21l-9-4.5v-9z"/><path d="m3 7.5 9 4.5 9-4.5M12 12v9"/>',
];
---
<section class="cz section">
  <div class="container">
    <div class="section-head section-head--split">
      <div class="cz__title">
        <span class="eyebrow">{d.eyebrow}</span>
        <h2 class="display-l" data-split>{d.title}</h2>
      </div>
      <p class="lead" data-reveal>{d.body}</p>
    </div>
    <div class="cz__grid" data-reveal-stagger>
      {d.items.map((item, i) => (
        <article class="cz__item">
          <div class="cz__top">
            <span class="cz__icon">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round" aria-hidden="true" set:html={icons[i]} />
            </span>
            <span class="cz__n">0{i + 1}</span>
          </div>
          <h3 class="display-s">{item.title}</h3>
          <p class="muted">{item.body}</p>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  .cz { background: var(--bg-2); border-block: 1px solid var(--line); }
  .cz__title { display: grid; gap: 16px; }
  .cz__grid { display: grid; gap: 20px; }
  @media (min-width: 700px) { .cz__grid { grid-template-columns: 1fr 1fr; } }
  @media (min-width: 1100px) { .cz__grid { grid-template-columns: repeat(3, 1fr); } }
  .cz__item { display: grid; gap: 14px; align-content: start; padding: 28px; background: var(--surface); border: 1px solid var(--line); transition: border-color 0.3s; }
  .cz__item:hover { border-color: var(--accent); }
  .cz__top { display: flex; justify-content: space-between; align-items: start; margin-bottom: 8px; }
  .cz__icon { width: 60px; height: 60px; display: grid; place-items: center; background: var(--accent-soft); color: var(--accent); }
  .cz__icon :global(svg) { width: 30px; height: 30px; }
  .cz__n { font-family: var(--font-display); font-weight: 800; font-size: 2.6rem; line-height: 0.8; color: transparent; -webkit-text-stroke: 1.2px var(--line-strong); }
</style>
