---
/**
 * Factory film: a short muted loop plays in place; the button swaps in the full film
 * (with sound and controls) in the same frame. Handled by ui.ts ([data-film]).
 */
import Icon from './Icon.astro';
import { t, type Lang } from '../i18n';

interface Props { lang: Lang; class?: string; }
const { lang, class: cls } = Astro.props;
const d = t(lang).factory;
---
<div class:list={['fvideo', cls]} data-film="/video/factory-film.mp4" data-clip>
  <video class="fvideo__media" autoplay muted loop playsinline preload="metadata" poster="/video/factory-poster.jpg" data-loop>
    <source src="/video/factory-loop.mp4" type="video/mp4" />
  </video>
  <button class="fvideo__play" type="button" data-film-play>
    <span class="fvideo__icon"><Icon name="play" /></span>
    <span class="fvideo__label">{d.watch}</span>
    <span class="fvideo__time">2:11</span>
  </button>
</div>

<style>
  .fvideo { position: relative; aspect-ratio: 16 / 9; overflow: hidden; background: #000; border: 1px solid var(--line); }
  .fvideo__media { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
  .fvideo::after { content: ''; position: absolute; inset: 0; background: linear-gradient(180deg, transparent 45%, rgba(0, 0, 0, 0.65)); pointer-events: none; transition: opacity 0.4s; }
  .fvideo__play {
    position: absolute; left: 20px; bottom: 20px; z-index: 2;
    display: inline-flex; align-items: center; gap: 14px; padding: 8px 18px 8px 8px;
    background: rgba(10, 11, 8, 0.6); backdrop-filter: blur(10px); -webkit-backdrop-filter: blur(10px);
    border: 1px solid rgba(238, 235, 225, 0.2); color: #eeebe1;
    font-family: var(--font-display); font-weight: 700; letter-spacing: 0.1em; text-transform: uppercase;
    transition: background-color 0.3s, border-color 0.3s;
  }
  .fvideo__play:hover { background: var(--accent-fill); border-color: var(--accent-fill); }
  .fvideo__icon { width: 44px; height: 44px; display: grid; place-items: center; background: var(--accent-fill); }
  .fvideo__play:hover .fvideo__icon { background: rgba(0, 0, 0, 0.25); }
  .fvideo__icon :global(svg) { width: 18px; height: 18px; margin-left: 2px; }
  .fvideo__time { font-weight: 500; opacity: 0.7; letter-spacing: 0.06em; }
  .fvideo:global(.is-playing)::after, .fvideo:global(.is-playing) .fvideo__play { opacity: 0; pointer-events: none; }
</style>
