---
import Logo from './Logo.astro';
import Icon from './Icon.astro';
import { BOOKING_URL, EMAIL, ISPO, PHONE_DISPLAY, PHONE_E164, whatsappUrl } from '../data/site';
import { CATEGORIES } from '../data/products';
import { localePath, t, type Lang } from '../i18n';

const { lang } = Astro.props as { lang: Lang };
const d = t(lang);
const p = (to: string) => localePath(lang, to);
const year = new Date().getFullYear();
---
<footer class="footer">
  <div class="container footer__grid">
    <div class="footer__brand">
      <Logo />
      <p class="muted">{d.footer.tagline}</p>
      <div class="footer__ispo">
        <span class="eyebrow">ISPO 2026</span>
        <p>{ISPO.venue} · {ISPO.dates[lang]} · {d.ispo.stand} {ISPO.stand}</p>
      </div>
    </div>
    <div>
      <h3 class="footer__h">{d.footer.explore}</h3>
      <ul>
        {CATEGORIES.map((c) => <li><a href={p(`/products/${c.id}`)}>{c.name[lang]}</a></li>)}
        <li><a href={p('/products')}>{d.shop.allProducts}</a></li>
      </ul>
    </div>
    <div>
      <h3 class="footer__h">{d.footer.company}</h3>
      <ul>
        <li><a href={p('/oem-odm')}>{d.nav.build}</a></li>
        <li><a href={p('/factory')}>{d.nav.factory}</a></li>
        <li><a href={p('/about')}>{d.nav.about}</a></li>
        <li><a href={p('/ispo-2026')}>{d.nav.ispo}</a></li>
      </ul>
    </div>
    <div>
      <h3 class="footer__h">{d.footer.contact}</h3>
      <ul>
        <li><a href={BOOKING_URL} target="_blank" rel="noopener"><Icon name="calendar" /> {d.nav.book}</a></li>
        <li><a href={whatsappUrl(d.cta.whatsappMsg)} target="_blank" rel="noopener"><Icon name="whatsapp" /> WhatsApp</a></li>
        <li><a href={`tel:+${PHONE_E164}`}><Icon name="phone" /> {PHONE_DISPLAY}</a></li>
        {EMAIL && <li><a href={`mailto:${EMAIL}`}><Icon name="mail" /> {EMAIL}</a></li>}
      </ul>
    </div>
  </div>
  <div class="container footer__bottom">
    <span>© {year} Tribe Gear B2B. {d.footer.rights}</span>
    <a href={p('/privacy')}>{d.footer.privacy}</a>
  </div>
  <div class="fword" data-footer-word aria-hidden="true">
    <div class="container">
      <div class="fword__clip">
        <div class="fword__mark" data-footer-mark>
          <span class="fword__fill"></span>
          <span class="fword__light" data-footer-light></span>
        </div>
      </div>
    </div>
  </div>
</footer>

<style>
  .footer { background: var(--bg-2); border-top: 1px solid var(--line); overflow: hidden; }
  /* Closing wordmark: the real logo, masked over a gradient + a spotlight that follows the cursor */
  .fword { overflow: hidden; padding-top: clamp(24px, 4vw, 48px); }
  .fword__clip { overflow: hidden; height: calc((100vw - 2 * var(--gutter)) * 566 / 4267 * 0.86); max-height: calc((var(--container) - 2 * var(--gutter)) * 566 / 4267 * 0.86); }
  .fword__mark {
    --mx: 50%; --my: 40%;
    position: relative; width: 100%; aspect-ratio: 4267 / 566;
    -webkit-mask: url('/brand/tribe-gear-wordmark.svg') center / 100% 100% no-repeat;
    mask: url('/brand/tribe-gear-wordmark.svg') center / 100% 100% no-repeat;
    will-change: transform;
  }
  .fword__fill, .fword__light { position: absolute; inset: 0; }
  .fword__fill { background: linear-gradient(180deg, rgba(238, 235, 225, 0.16) 0%, rgba(238, 235, 225, 0.06) 55%, rgba(238, 235, 225, 0) 100%); }
  .fword__light {
    background: radial-gradient(circle 22vw at var(--mx) var(--my), rgba(163, 176, 108, 0.95) 0%, rgba(110, 122, 52, 0.55) 35%, transparent 70%);
    opacity: 0; transition: opacity 0.5s var(--ease);
  }
  .fword:hover .fword__light, .fword__light.is-on { opacity: 1; }
  @media (hover: none) {
    .fword__light.is-on { animation: fwsweep 2.6s var(--ease) forwards; }
  }
  @keyframes fwsweep { 0% { --mx: 0%; opacity: 0; } 20% { opacity: 1; } 100% { --mx: 100%; opacity: 0; } }
  .footer__grid { display: grid; gap: 40px; padding-block: 56px; grid-template-columns: 1fr 1fr; }
  .footer__brand { grid-column: 1 / -1; display: grid; gap: 20px; align-content: start; max-width: 380px; }
  .footer__ispo { padding-top: 16px; border-top: 1px solid var(--line); display: grid; gap: 6px; font-size: 0.95rem; }
  .footer__h { font-size: 1.05rem; letter-spacing: 0.14em; color: var(--ink-3); margin-bottom: 16px; }
  ul { list-style: none; margin: 0; padding: 0; display: grid; gap: 10px; }
  li a { display: inline-flex; align-items: center; gap: 10px; color: var(--ink-2); transition: color 0.2s; }
  li a:hover { color: var(--accent); }
  li :global(svg) { width: 16px; height: 16px; }
  .footer__bottom { display: flex; flex-wrap: wrap; justify-content: space-between; gap: 12px; padding-block: 24px; border-top: 1px solid var(--line); font-size: 0.85rem; color: var(--ink-3); }
  .footer__bottom a:hover { color: var(--ink); }
  @media (min-width: 900px) {
    .footer__grid { grid-template-columns: 1.6fr 1fr 1fr 1.2fr; }
    .footer__brand { grid-column: auto; }
  }
</style>
