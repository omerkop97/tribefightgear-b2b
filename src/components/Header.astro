---
import Logo from './Logo.astro';
import Icon from './Icon.astro';
import { BOOKING_URL } from '../data/site';
import { CATEGORIES } from '../data/products';
import { linesInCategory, productsIn } from '../data/shop';
import { localePath, t, type Lang } from '../i18n';

interface Props { lang: Lang; path: string; }
const { lang, path } = Astro.props;
const d = t(lang);
const p = (to: string) => localePath(lang, to);
const other: Lang = lang === 'en' ? 'nl' : 'en';
const isActive = (to: string) => path === to || path.startsWith(to + '/');

// Only lines without products yet get a note; no product counts.
const note = (n: number) => (n ? '' : 'ISPO 2026');

// Each category opens to its lines (levels, or Accessories / Fightwear).
const menus = CATEGORIES.map((c) => {
  const lines = linesInCategory(c.id);
  const items = lines.length > 1
    ? lines.map((l) => ({ href: `/products/${c.id}/${l.id}`, name: l.name[lang], meta: note(productsIn(c.id, l.id).length), tone: l.id }))
    : [];
  return { id: c.id, name: c.name[lang], items };
});

const links = [
  { to: '/oem-odm', label: d.nav.build },
  { to: '/factory', label: d.nav.factory },
  { to: '/about', label: d.nav.about },
  { to: '/ispo-2026', label: d.nav.ispo },
  { to: '/contact', label: d.nav.contact },
];
---
<header class="header" data-header>
  <div class="header__inner container">
    <a href={p('/')} class="header__logo"><Logo /></a>

    <nav class="nav" aria-label="Main">
      {menus.map((m) => (
        <div class:list={['nav__item', { 'nav__item--drop': m.items.length > 0 }]}>
          <a href={p(`/products/${m.id}`)} class:list={['nav__link', { 'is-active': isActive(`/products/${m.id}`) }]}>
            {m.name} {m.items.length > 0 && <Icon name="chevron" />}
          </a>
          {m.items.length > 0 && (
            <div class="drop">
              <div class="drop__menu">
                {m.items.map((it) => (
                  <a href={p(it.href)} class:list={['drop__row', it.tone && `drop__row--${it.tone}`]}>
                    <span class="drop__name">{it.name}</span>
                    {it.meta && <span class="drop__meta">{it.meta}</span>}
                  </a>
                ))}
                <a href={p(`/products/${m.id}`)} class="drop__row drop__row--all">
                  <span class="drop__name">{d.shop.viewAll} {m.name}</span>
                  <Icon name="arrow" />
                </a>
              </div>
            </div>
          )}
        </div>
      ))}
      <div class="nav__item nav__item--drop nav__item--company">
        <span class:list={['nav__link', { 'is-active': links.some((l) => isActive(l.to)) }]} tabindex="0">{d.shop.company} <Icon name="chevron" /></span>
        <div class="drop drop--right">
          <div class="drop__menu">
            {links.map((l) => (
              <a href={p(l.to)} class="drop__row"><span class="drop__name">{l.label}</span></a>
            ))}
          </div>
        </div>
      </div>
    </nav>

    <div class="header__tools">
      <a class="tool tool--lang" href={localePath(other, path)} hreflang={other} lang={other} aria-label={other === 'nl' ? 'Nederlands' : 'English'}>
        <span class:list={{ on: lang === 'en' }}>EN</span><span class="sep">/</span><span class:list={{ on: lang === 'nl' }}>NL</span>
      </a>
      <a class="btn btn--primary btn--sm header__cta" href={BOOKING_URL} target="_blank" rel="noopener">
        <Icon name="calendar" /> {d.nav.book}
      </a>
      <button class="tool tool--menu" type="button" data-menu-open aria-expanded="false" aria-controls="mobile-menu">
        <span class="sr-only">{d.nav.menu}</span>
        <Icon name="menu" />
      </button>
    </div>
  </div>
</header>

<div class="mmenu" id="mobile-menu" data-menu hidden>
  <div class="mmenu__top container">
    <a href={p('/')}><Logo /></a>
    <button class="tool" type="button" data-menu-close><span class="sr-only">{d.nav.close}</span><Icon name="close" /></button>
  </div>
  <nav class="mmenu__nav container" aria-label="Mobile">
    {menus.map((m) => (
      <>
        <a href={p(`/products/${m.id}`)} class="mmenu__link">{m.name}</a>
        {m.items.length > 0 && (
          <div class="mmenu__sub">
            {m.items.map((it) => <a href={p(it.href)}>{it.name}</a>)}
          </div>
        )}
      </>
    ))}
    <div class="mmenu__company">
    {links.map((l) => <a href={p(l.to)}>{l.label}</a>)}
    </div>
  </nav>
  <div class="mmenu__foot container">
    <a class="btn btn--primary" href={BOOKING_URL} target="_blank" rel="noopener"><Icon name="calendar" /> {d.cta.book}</a>
  </div>
</div>

<style>
  .header {
    position: sticky;
    top: 0;
    z-index: 50;
    height: var(--header-h);
    transition: background-color 0.4s var(--ease), border-color 0.4s var(--ease), transform 0.5s var(--ease), height 0.4s var(--ease);
    border-bottom: 1px solid transparent;
  }
  .header.is-scrolled {
    --header-h: 64px;
    background: color-mix(in srgb, var(--bg) 82%, transparent);
    backdrop-filter: blur(14px) saturate(1.4);
    -webkit-backdrop-filter: blur(14px) saturate(1.4);
    border-color: var(--line);
  }
  .header.is-hidden { transform: translateY(-100%); }
  .header__inner { height: 100%; display: flex; align-items: center; justify-content: space-between; gap: 16px; }

  .nav { display: none; align-items: center; gap: 4px; }
  .nav__item { position: relative; }
  .nav__link {
    display: inline-flex; align-items: center; gap: 4px;
    padding: 10px 10px;
    font-family: var(--font-display); font-weight: 600; font-size: 0.98rem; letter-spacing: 0.06em; text-transform: uppercase;
    color: var(--ink-2);
    transition: color 0.25s;
    position: relative;
  }
  .nav__link { white-space: nowrap; }
  .nav__link :global(svg) { width: 15px; height: 15px; flex: none; color: var(--accent); transition: transform 0.3s var(--ease); }
  .nav__item--drop:hover .nav__link :global(svg), .nav__item--drop:focus-within .nav__link :global(svg) { transform: rotate(180deg); }
  .nav__link::after {
    content: ''; position: absolute; left: 10px; right: 10px; bottom: 4px; height: 2px; background: var(--accent);
    transform: scaleX(0); transform-origin: left; transition: transform 0.4s var(--ease);
  }
  .nav__link:hover, .nav__link.is-active { color: var(--ink); }
  .nav__link:hover::after, .nav__link.is-active::after { transform: scaleX(1); }

  .drop {
    position: absolute; top: 100%; left: -12px; padding-top: 12px;
    opacity: 0; visibility: hidden; transform: translateY(8px);
    transition: opacity 0.3s var(--ease), transform 0.3s var(--ease), visibility 0.3s;
  }
  .nav__item--drop:hover .drop, .nav__item--drop:focus-within .drop { opacity: 1; visibility: visible; transform: none; }
  .drop__inner { width: 560px; display: grid; grid-template-columns: 1fr 1fr; background: var(--surface); border: 1px solid var(--line); box-shadow: var(--shadow); }
  .drop__link { display: grid; grid-template-columns: auto 1fr; column-gap: 12px; padding: 20px; border: 1px solid var(--line); margin: -1px 0 0 -1px; transition: background-color 0.25s; }
  .drop__link:hover { background: var(--accent-soft); }
  .drop__num { font-family: var(--font-display); color: var(--accent); font-weight: 700; grid-row: span 2; }
  .drop__name { font-family: var(--font-display); font-weight: 700; text-transform: uppercase; font-size: 1.15rem; letter-spacing: 0.03em; }
  .drop__desc { font-size: 0.85rem; color: var(--ink-2); line-height: 1.45; }
  .drop__link--elite .drop__name { color: var(--sand); }
  .drop__link--all { background: var(--accent-soft); }

  .drop__menu { min-width: 260px; display: grid; background: var(--surface); border: 1px solid var(--line); box-shadow: var(--shadow); padding: 8px; }
  .drop--right { left: auto; right: -12px; }
  .drop__row { display: flex; align-items: baseline; justify-content: space-between; gap: 24px; padding: 11px 12px; transition: background-color 0.2s; }
  .drop__row:hover { background: var(--accent-soft); }
  .drop__row .drop__name { font-size: 1.05rem; white-space: nowrap; }
  .drop__meta { font-size: 0.78rem; color: var(--ink-3); white-space: nowrap; font-variant-numeric: tabular-nums; }
  .drop__row--elite .drop__name { color: var(--sand); }
  .drop__row--all { margin-top: 4px; border-top: 1px solid var(--line); color: var(--accent); align-items: center; }
  .drop__row--all .drop__name { font-size: 0.95rem; letter-spacing: 0.06em; }
  .drop__row--all :global(svg) { width: 16px; height: 16px; flex: none; }
  .nav__item--company .nav__link { cursor: default; }
  .mmenu__company { display: flex; flex-wrap: wrap; gap: 8px 18px; padding: 20px 0; }
  .mmenu__company a { color: var(--ink-2); font-family: var(--font-display); font-weight: 600; text-transform: uppercase; letter-spacing: 0.08em; }
  .header__tools { display: flex; align-items: center; gap: 8px; }
  .tool { height: 42px; min-width: 42px; display: inline-grid; place-items: center; border: 1px solid var(--line); color: var(--ink); transition: border-color 0.25s, background-color 0.25s; }
  .tool:hover { border-color: var(--ink); }
  .tool :global(svg) { width: 19px; height: 19px; }
  .tool--lang { display: inline-flex; gap: 4px; padding: 0 12px; font-family: var(--font-display); font-weight: 700; letter-spacing: 0.08em; color: var(--ink-3); }
  .tool--lang .on { color: var(--ink); }
  .tool--lang .sep { opacity: 0.4; }
  .header__cta { display: none; }

  /* Small desktops: tighter type so all categories, chevrons and tools fit on one row. */
  @media (min-width: 1280px) {
    .nav__link { padding-inline: 8px; font-size: 0.95rem; letter-spacing: 0.04em; gap: 3px; }
    .nav__link::after { left: 8px; right: 8px; }
  }
  @media (min-width: 1280px) and (max-width: 1439px) {
    .nav__link { padding-inline: 7px; font-size: 0.9rem; gap: 2px; }
    .nav__link::after { left: 7px; right: 7px; }
    :global(.logo__sub) { display: none; }
  }
  @media (min-width: 1280px) {
    .nav { display: flex; }
    .header__cta { display: inline-flex; }
    .tool--menu { display: none; }
  }
  @media (max-width: 480px) { :global(.logo__sub) { display: none; } }

  /* Mobile menu */
  .mmenu {
    position: fixed; inset: 0; z-index: 90;
    background: var(--bg);
    display: flex; flex-direction: column;
    overflow-y: auto;
  }
  .mmenu[hidden] { display: none; }
  .mmenu__top { height: 76px; display: flex; align-items: center; justify-content: space-between; border-bottom: 1px solid var(--line); }
  .mmenu__nav { display: flex; flex-direction: column; padding-block: 24px; flex: 1; }
  .mmenu__link {
    font-family: var(--font-display); font-weight: 800; text-transform: uppercase;
    font-size: clamp(2.2rem, 10vw, 3.4rem); line-height: 1.1; padding-block: 6px;
    border-bottom: 1px solid var(--line);
  }
  .mmenu__sub { display: flex; flex-wrap: wrap; gap: 8px 16px; padding: 12px 0 18px; border-bottom: 1px solid var(--line); }
  .mmenu__sub a { color: var(--ink-2); font-size: 0.95rem; }
  .mmenu__foot { padding-bottom: 32px; }
  .mmenu__foot .btn { width: 100%; }
</style>
