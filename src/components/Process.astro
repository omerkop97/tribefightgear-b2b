---
import { t, type Lang } from '../i18n';

const { lang } = Astro.props as { lang: Lang };
const d = t(lang);
---
<div class="process" data-process>
  <h3 class="process__title">{d.build.processTitle}</h3>
  <div class="process__rail">
    <div class="process__track"><div class="process__line" data-process-line></div></div>
    <ol class="process__steps">
      {d.build.process.map((step, i) => (
        <li data-process-step>
          <span class="process__dot"></span>
          <span class="process__n">{String(i + 1).padStart(2, '0')}</span>
          <span class="process__name">{step}</span>
        </li>
      ))}
    </ol>
  </div>
</div>

<style>
  .process { margin-top: clamp(48px, 6vw, 80px); padding: clamp(28px, 4vw, 48px); background: var(--panel-bg); color: var(--panel-ink); border: 1px solid var(--line); }
  .process__title { font-size: clamp(1.3rem, 2vw, 1.7rem); letter-spacing: 0.06em; margin-bottom: 36px; }
  .process__rail { position: relative; }
  .process__track { position: absolute; left: 0; right: 0; top: 7px; height: 2px; background: color-mix(in srgb, var(--panel-ink) 18%, transparent); }
  .process__line { height: 100%; background: var(--accent); transform-origin: left; transform: scaleX(0); }
  .process__steps { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(7, 1fr); gap: 8px; }
  .process__steps li { display: grid; gap: 6px; opacity: 0.4; transition: opacity 0.5s var(--ease); }
  .process__steps li:global(.is-on) { opacity: 1; }
  .process__dot { width: 16px; height: 16px; border: 2px solid currentColor; background: var(--panel-bg); position: relative; z-index: 1; transition: background-color 0.4s, border-color 0.4s; }
  .process__steps li:global(.is-on) .process__dot { background: var(--accent); border-color: var(--accent); }
  .process__n { font-size: 0.75rem; letter-spacing: 0.14em; margin-top: 12px; opacity: 0.6; }
  .process__name { font-family: var(--font-display); font-weight: 700; text-transform: uppercase; font-size: clamp(1rem, 1.6vw, 1.45rem); letter-spacing: 0.04em; }
  :global(html:not(.motion)) .process__steps li { opacity: 1; }
  :global(html:not(.motion)) .process__line { transform: none; }

  @media (max-width: 760px) {
    .process__track { left: 7px; right: auto; top: 0; bottom: 0; width: 2px; height: auto; }
    .process__line { transform-origin: top; width: 100%; height: 100%; transform: scaleY(0); }
    .process__steps { grid-template-columns: 1fr; gap: 18px; }
    .process__steps li { grid-template-columns: 16px 32px 1fr; align-items: center; gap: 14px; }
    .process__n { margin: 0; }
  }
</style>
