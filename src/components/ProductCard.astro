---
import { photo, photoSrcset, productPath, type Product } from '../data/shop';
import { localePath, type Lang } from '../i18n';

interface Props { product: Product; lang: Lang; }
const { product: p, lang } = Astro.props;
const href = localePath(lang, productPath(p));
---
<a class:list={['pcard', `pcard--${p.line}`]} href={href} data-category={p.category} data-line={p.line} data-type={p.type.en}>
  <div class="pcard__stage stage">
    <img class="pcard__img" src={photo(p, 1, 700)} srcset={photoSrcset(p, 1)} sizes="(min-width: 1100px) 30vw, (min-width: 640px) 45vw, 90vw" alt={`${p.title[lang]}, ${p.colour.name[lang]}`} width="700" height="700" loading="lazy" />
    {p.images > 1 && <img class="pcard__img pcard__img--alt" src={photo(p, 2, 700)} alt="" aria-hidden="true" width="700" height="700" loading="lazy" />}
  </div>
  <div class="pcard__body">
    <h3 class="pcard__title">{p.title[lang]}</h3>
    <div class="pcard__meta">
      <span class="pcard__colour">{p.colour.name[lang]}</span>
      <span class="pcard__sku">{p.sku}</span>
    </div>
  </div>
</a>

<style>
  .pcard { display: grid; gap: 14px; align-content: start; }
  .pcard__stage { background: var(--stage); }
  .pcard__stage { aspect-ratio: 1; border: 1px solid var(--line); transition: border-color 0.4s var(--ease); }
  .pcard:hover .pcard__stage { border-color: var(--accent); }
  .pcard__img { position: absolute; inset: 0; padding: 9%; transition: opacity 0.5s var(--ease), transform 0.8s var(--ease); }
  .pcard__img--alt { opacity: 0; }
  .pcard:hover .pcard__img { transform: scale(1.06); }
  .pcard:hover .pcard__img--alt { opacity: 1; }
  .pcard:hover .pcard__img:not(.pcard__img--alt):has(+ .pcard__img--alt) { opacity: 0; }
  .pcard__body { display: grid; gap: 8px; padding-top: 2px; border-top: 1px solid var(--line); padding-top: 12px; }
  .pcard__meta { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: baseline; gap: 2px 12px; }
  @media (max-width: 520px) { .pcard__meta { flex-direction: column; } .pcard__title { font-size: 1rem; } }
  .pcard__title { font-size: 1.15rem; letter-spacing: 0.03em; line-height: 1.1; transition: color 0.25s; }
  .pcard:hover .pcard__title { color: var(--accent); }
  .pcard__colour { font-size: 0.85rem; color: var(--ink-2); }
  .pcard__sku { font-size: 0.72rem; white-space: nowrap; letter-spacing: 0.08em; color: var(--ink-3); font-variant-numeric: tabular-nums; }
</style>
