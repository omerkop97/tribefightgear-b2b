---
import Base from '../layouts/Base.astro';
import Icon from './Icon.astro';
import Lightbox from './Lightbox.astro';
import ProductCard from './ProductCard.astro';
import CtaStrip from './CtaStrip.astro';
import { CATEGORIES } from '../data/products';
import { PRODUCTS, lineById, linesInCategory, photo, photoSrcset, productPath, siblings, type Product } from '../data/shop';
import { BOOKING_URL, whatsappUrl } from '../data/site';
import { localePath, t, type Lang } from '../i18n';

interface Props { product: Product; lang: Lang; }
const { product: p, lang } = Astro.props;
const d = t(lang);
const line = lineById(p.line);
const category = CATEGORIES.find((c) => c.id === p.category)!;
const title = p.title[lang];
const angles = Array.from({ length: p.images }, (_, i) => i + 1);
const colour = p.colour.name[lang];
const others = siblings(p);
const ask = whatsappUrl(d.shop.requestMsg.replace('{title}', `${title} (${colour})`));
const categoryPath = `/products/${p.category}`;
// A line page exists only when the category has more than one line (Accessories has just one).
const linePath = linesInCategory(p.category).length > 1 ? `${categoryPath}/${p.line}` : categoryPath;

// Same category: same line first, then the other lines.
const related = PRODUCTS.filter((x) => x.category === p.category && x !== p)
  .sort((a, b) => Number(b.line === p.line) - Number(a.line === p.line))
  .slice(0, 6);

---
<Base lang={lang} path={productPath(p)} title={`${title} ${colour}`} description={`${title}, ${line.name[lang]}. ${line.body[lang]}`}>
  <section class="pd">
    <div class="container">
      <nav class="crumbs" aria-label="Breadcrumb">
        <a href={localePath(lang, '/')}>Home</a><span>/</span>
        <a href={localePath(lang, categoryPath)}>{category.name[lang]}</a><span>/</span>
        {linePath !== categoryPath && <><a href={localePath(lang, linePath)}>{line.name[lang]}</a><span>/</span></>}
        <span aria-current="page">{title}</span>
      </nav>

      <div class="pd__grid">
        <div class="pd__media" data-gallery data-lightbox-group={p.id}>
          <button class="pd__stage stage grain" type="button" data-lightbox-open aria-label={`${d.products.enlarge}: ${title}`}>
            <img
              data-gallery-main
              src={photo(p, 1, 1400)}
              srcset={photoSrcset(p, 1)}
              sizes="(min-width: 1024px) 55vw, 92vw"
              alt={title}
              width="1400" height="1400" fetchpriority="high"
            />
            <span class="pd__zoom"><Icon name="plus" /></span>
          </button>
          {p.images > 1 && (
            <div class="pd__thumbs" role="group" aria-label={`${p.images} ${d.shop.angles}`}>
              {angles.map((n) => (
                <button
                  type="button"
                  data-gallery-thumb
                  data-lightbox-item={photo(p, n, 1400)}
                  data-src={photo(p, n, 1400)}
                  data-srcset={photoSrcset(p, n)}
                  aria-pressed={n === 1 ? 'true' : 'false'}
                  aria-label={`${d.products.view} ${n}`}
                >
                  <img src={photo(p, n, 700)} alt="" width="700" height="700" loading="lazy" />
                </button>
              ))}
            </div>
          )}
        </div>

        <div class="pd__info">
          <a class:list={['pd__line', `pd__line--${p.line}`]} href={localePath(lang, linePath)}>{line.name[lang]}</a>
          <h1 class="pd__title">{title}</h1>
          <p class="pd__colour">{colour}</p>

          <dl class="pd__specs">
            <div><dt>{d.shop.type}</dt><dd>{p.type[lang]}</dd></div>
            <div><dt>{d.shop.category}</dt><dd><a href={localePath(lang, categoryPath)}>{category.name[lang]}</a></dd></div>
            <div><dt>{d.shop.line}</dt><dd>{line.name[lang]}</dd></div>
            <div><dt>{d.shop.colour}</dt><dd>{colour}</dd></div>
            {p.closure && <div><dt>{d.shop.closure}</dt><dd>{p.closure.name[lang]}</dd></div>}
            {p.material && <div><dt>{d.products.material}</dt><dd>{p.material[lang]}</dd></div>}
          </dl>

          {others.length > 0 && (
            <div class="pd__variants">
              <span class="pd__label">{d.shop.alsoIn}</span>
              <div class="pd__swatches">
                <span class="pd__swatch is-current" aria-current="true">
                  <img src={photo(p, 1, 700)} alt="" width="700" height="700" />
                  <span>{colour}{p.closure && <><br />{p.closure.name[lang]}</>}</span>
                </span>
                {others.map((o) => (
                  <a class="pd__swatch" href={localePath(lang, productPath(o))}>
                    <img src={photo(o, 1, 700)} alt="" width="700" height="700" loading="lazy" />
                    <span>{o.colour.name[lang]}{o.closure && <><br />{o.closure.name[lang]}</>}</span>
                  </a>
                ))}
              </div>
            </div>
          )}

          <div class="pd__opts">
            <span class="pd__label">{d.products.options}</span>
            <ul>{d.products.optionList.map((o) => <li><Icon name="check" />{o}</li>)}</ul>
          </div>

          <div class="pd__ctas">
            <a class="btn btn--primary" href={ask} target="_blank" rel="noopener"><Icon name="whatsapp" /> {d.shop.request}</a>
            <a class="btn btn--ghost" href={BOOKING_URL} target="_blank" rel="noopener"><Icon name="calendar" /> {d.cta.book}</a>
          </div>
        </div>
      </div>
    </div>
  </section>


  {related.length > 0 && (
    <section class="section related">
      <div class="container">
        <div class="related__head">
          <h2 class="display-m">{d.shop.more} {category.name[lang]}</h2>
          <a class="link-arrow" href={localePath(lang, categoryPath)}>{d.shop.viewAll} {category.name[lang]} <Icon name="arrow" /></a>
        </div>
        <div class="related__grid">
          {related.map((r) => <ProductCard product={r} lang={lang} />)}
        </div>
      </div>
    </section>
  )}

  <CtaStrip lang={lang} />
  <Lightbox lang={lang} />
</Base>

<style>
  .pd { padding-block: clamp(28px, 4vw, 48px) clamp(64px, 8vw, 112px); }
  .crumbs { display: flex; flex-wrap: wrap; gap: 8px; font-size: 0.85rem; color: var(--ink-3); margin-bottom: clamp(20px, 3vw, 36px); }
  .crumbs a:hover { color: var(--accent); }
  .pd__grid { display: grid; gap: clamp(28px, 4vw, 64px); align-items: start; }
  @media (min-width: 1024px) {
    .pd__grid { grid-template-columns: 1.25fr 1fr; }
    .pd__info { position: sticky; top: 100px; }
  }

  .pd__media { display: grid; gap: 10px; }
  .pd__stage { display: block; width: 100%; aspect-ratio: 1; padding: 0; border: 1px solid var(--line); cursor: zoom-in; }
  .pd__stage img { padding: 7%; transition: transform 0.9s var(--ease); }
  .pd__stage:hover img { transform: scale(1.04); }
  .pd__zoom { position: absolute; right: 16px; bottom: 16px; z-index: 2; width: 44px; height: 44px; display: grid; place-items: center; background: var(--accent-fill); color: var(--on-accent); transition: transform 0.4s var(--ease); }
  .pd__zoom :global(svg) { width: 20px; height: 20px; }
  .pd__stage:hover .pd__zoom { transform: rotate(90deg); }
  .pd__thumbs { display: grid; grid-template-columns: repeat(6, 1fr); gap: 10px; }
  .pd__thumbs button { aspect-ratio: 1; background: var(--stage); border: 1px solid var(--line); opacity: 0.7; transition: opacity 0.25s, border-color 0.25s; }
  .pd__thumbs button:hover { opacity: 1; }
  .pd__thumbs button[aria-pressed='true'] { opacity: 1; border-color: var(--accent); box-shadow: inset 0 0 0 1px var(--accent); }
  .pd__thumbs img { width: 100%; height: 100%; object-fit: contain; padding: 8%; }

  .pd__info { display: grid; gap: 20px; align-content: start; }
  .pd__line { justify-self: start; font-size: 0.72rem; letter-spacing: 0.16em; text-transform: uppercase; padding: 5px 10px; border: 1px solid var(--line-strong); color: var(--accent); }
  .pd__line--elite { color: var(--sand); border-color: color-mix(in srgb, var(--sand) 45%, transparent); }
  .pd__title { font-size: clamp(2.6rem, 5vw, 4.4rem); font-weight: 800; }
  .pd__colour { margin-top: -12px; font-size: 1.15rem; color: var(--ink-2); }
  .pd__variants { display: grid; gap: 12px; }
  .pd__swatches { display: flex; flex-wrap: wrap; gap: 10px; }
  .pd__swatch { display: grid; gap: 6px; width: 104px; text-align: center; font-size: 0.78rem; color: var(--ink-2); }
  .pd__swatch img { width: 104px; height: 104px; object-fit: contain; padding: 8%; background: var(--stage); border: 1px solid var(--line); transition: border-color 0.25s; }
  .pd__swatch:hover img { border-color: var(--ink-3); }
  .pd__swatch.is-current img { border-color: var(--accent); box-shadow: inset 0 0 0 1px var(--accent); }
  .pd__swatch.is-current { color: var(--ink); }
  .pd__specs { margin: 0; display: grid; border-top: 1px solid var(--line); }
  .pd__specs div { display: grid; grid-template-columns: 140px 1fr; gap: 16px; padding: 12px 0; border-bottom: 1px solid var(--line); }
  .pd__specs dt { font-size: 0.75rem; letter-spacing: 0.14em; text-transform: uppercase; color: var(--ink-3); align-self: center; }
  .pd__specs dd { margin: 0; font-weight: 600; }
  .pd__specs dd a:hover { color: var(--accent); }
  .pd__opts { display: grid; gap: 12px; }
  .pd__label { font-size: 0.75rem; letter-spacing: 0.14em; text-transform: uppercase; color: var(--ink-3); }
  .pd__opts ul { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; gap: 8px; }
  .pd__opts li { display: inline-flex; align-items: center; gap: 6px; padding: 7px 12px; border: 1px solid var(--line); font-size: 0.88rem; background: var(--surface); }
  .pd__opts li :global(svg) { width: 14px; height: 14px; color: var(--accent); }
  .pd__ctas { display: flex; flex-wrap: wrap; gap: 12px; padding-top: 4px; }
  @media (max-width: 520px) {
    .pd__thumbs { grid-template-columns: repeat(4, 1fr); }
    .pd__ctas .btn { width: 100%; }
    .pd__specs div { grid-template-columns: 110px 1fr; }
  }

  .related { border-top: 1px solid var(--line); }
  .related__head { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: end; gap: 16px; margin-bottom: 32px; }
  .related__grid { display: grid; gap: 40px 20px; grid-template-columns: 1fr 1fr; }
  @media (min-width: 900px) { .related__grid { grid-template-columns: repeat(3, 1fr); gap: 48px 24px; } }
</style>
