---
import ProductCard from './ProductCard.astro';
import type { Product } from '../data/shop';
import { t, type Lang } from '../i18n';

/** Webshop-style grid with filter chips (client-side, no reload). */
interface Props {
  products: Product[];
  lang: Lang;
  /** Chips to filter by; each value matches a card's data-category or data-line. */
  filters?: { key: 'category' | 'line' | 'type'; options: { value: string; label: string }[] };
}
const { products, lang, filters } = Astro.props;
const d = t(lang).shop;
const valueOf = (p: Product, key: 'category' | 'line' | 'type') => (key === 'type' ? p.type.en : p[key]);
const options = (filters?.options ?? []).filter((o) => products.some((p) => valueOf(p, filters!.key) === o.value));
---
<div class="pgrid" data-pgrid data-filter-key={filters?.key}>
  {options.length > 1 && (
    <div class="pgrid__bar">
      <div class="pgrid__chips" role="group" aria-label={d.filter}>
        <button type="button" class="chip" data-filter-value="" aria-pressed="true">{d.all}</button>
        {options.map((o) => <button type="button" class="chip" data-filter-value={o.value} aria-pressed="false">{o.label}</button>)}
      </div>
    </div>
  )}
  <div class="pgrid__items" data-batch>
    {products.map((p) => <ProductCard product={p} lang={lang} />)}
  </div>
</div>

<style>
  .pgrid__bar { display: flex; flex-wrap: wrap; align-items: center; gap: 16px; margin-bottom: 28px; }
  .pgrid__chips { display: flex; flex-wrap: wrap; gap: 8px; }
  .chip { padding: 7px 14px; border-radius: 999px; border: 1px solid var(--line-strong); font-family: var(--font-display); font-weight: 600; font-size: 0.95rem; letter-spacing: 0.08em; text-transform: uppercase; color: var(--ink-2); transition: background-color 0.25s, color 0.25s, border-color 0.25s; }
  .chip:hover { color: var(--ink); border-color: var(--ink); }
  .chip[aria-pressed='true'] { background: var(--accent-fill); border-color: var(--accent-fill); color: var(--on-accent); }
  .pgrid__items { display: grid; gap: 36px 16px; grid-template-columns: 1fr 1fr; }
  @media (min-width: 900px) { .pgrid__items { grid-template-columns: repeat(3, 1fr); gap: 44px 20px; } }
  @media (min-width: 1200px) { .pgrid__items { grid-template-columns: repeat(4, 1fr); } }
  @media (max-width: 420px) { .pgrid__items { gap: 28px 12px; } }
  .pgrid__items > :global([hidden]) { display: none; }
</style>
