---
import Icon from '../Icon.astro';
import PeopleCards from '../PeopleCards.astro';
import FactoryVideo from '../FactoryVideo.astro';
import { whatsappUrl } from '../../data/site';
import { localePath, t, type Lang } from '../../i18n';

const { lang } = Astro.props as { lang: Lang };
const d = t(lang);
---
<section class="fa section" id="factory">
  <div class="container">
    <div class="fa__factory">
      <div class="fa__copy">
        <span class="eyebrow">{d.factory.eyebrow}</span>
        <h2 class="display-l" data-split>{d.factory.title[0]}<br /><span class="accent">{d.factory.title[1]}</span></h2>
        <p class="lead" data-reveal>{d.factory.body}</p>
        <div data-reveal>
          <a class="btn btn--primary" href={whatsappUrl(d.cta.whatsappMsg)} target="_blank" rel="noopener">{d.factory.cta} <Icon name="arrow" /></a>
        </div>
      </div>
      <FactoryVideo lang={lang} />
    </div>

    <div class="fa__statement" aria-hidden="true">
      <span data-parallax="0.12">{d.about.lead}</span>
    </div>

    <div class="fa__about">
      <div class="fa__about-copy">
        <span class="eyebrow">{d.about.eyebrow}</span>
        <h2 class="display-m" data-split>{d.about.title}</h2>
        <p class="lead" data-reveal>{d.about.body}</p>
        <a class="link-arrow" href={localePath(lang, '/about')} data-reveal>{d.about.more} <Icon name="arrow" /></a>
      </div>
      <PeopleCards lang={lang} />
    </div>
  </div>
</section>

<style>
  .fa__factory { display: grid; gap: 40px; align-items: center; }
  .fa__copy { display: grid; gap: 24px; justify-items: start; }
  .fa__statement {
    margin-block: clamp(72px, 10vw, 140px);
    font-family: var(--font-display); font-weight: 800; text-transform: uppercase;
    font-size: clamp(2.6rem, 8vw, 7.5rem); line-height: 0.9; text-align: center;
    color: transparent; -webkit-text-stroke: 1.5px var(--accent);
  }
  .fa__statement span { display: block; }
  .fa__about { display: grid; gap: 48px; }
  .fa__about-copy { display: grid; gap: 20px; align-content: start; }
  @media (min-width: 1024px) {
    .fa__factory { grid-template-columns: 1fr 1.15fr; gap: 72px; }
    .fa__about { grid-template-columns: 1fr 1.4fr; gap: 72px; }
    .fa__about-copy { position: sticky; top: 120px; }
  }
</style>
