---
import Icon from '../Icon.astro';
import { BOOKING_URL, whatsappUrl } from '../../data/site';
import { img, srcset } from '../../data/products';
import { t, type Lang } from '../../i18n';

const { lang } = Astro.props as { lang: Lang };
const d = t(lang);
const lines = d.hero.title;
---
<section class="hero" data-hero>
  <div class="hero__word" data-hero-word aria-hidden="true">Fight<br />Gear</div>
  <div class="hero__grid container">
    <div class="hero__copy">
      <span class="eyebrow" data-hero-in>{d.hero.eyebrow}</span>
      <h1 class="display-xl hero__title" data-split="load">
        {lines.map((line, i) => (
          <span class:list={['hero__line', { accent: i === lines.length - 1 }]}>{line}</span>
        ))}
      </h1>
      <p class="lead" data-hero-in>{d.hero.body}</p>
      <div class="hero__ctas" data-hero-in>
        <a class="btn btn--primary" href={BOOKING_URL} target="_blank" rel="noopener">
          <Icon name="calendar" /> {d.cta.book}
        </a>
        <a class="btn btn--ghost btn--wa" href={whatsappUrl(d.cta.whatsappMsg)} target="_blank" rel="noopener">
          <Icon name="whatsapp" class="wa" /> {d.cta.whatsapp}
        </a>
      </div>
    </div>
    <div class="hero__visual">
      <div class="hero__glow" aria-hidden="true"></div>
      <img
        data-hero-product
        class="hero__product"
        src={img('gloves', 'apex', 1)}
        srcset={srcset('gloves', 'apex', 1)}
        sizes="(min-width: 1024px) 50vw, 90vw"
        alt="Tribe Gear Apex Elite boxing gloves"
        width="1400"
        height="1400"
        fetchpriority="high"
      />
    </div>
  </div>
  <div class="hero__foot container" data-hero-in>
    <span class="hero__scroll"><span></span>{d.hero.scroll}</span>
    <span class="hero__meta">OEM · ODM · Private Label</span>
  </div>
</section>

<style>
  .hero {
    position: relative;
    min-height: calc(100svh - var(--banner-h) - var(--header-h));
    display: flex;
    flex-direction: column;
    overflow: hidden;
    isolation: isolate;
  }
  .hero__word {
    position: absolute;
    right: -2vw;
    top: 50%;
    translate: 0 -50%;
    z-index: -1;
    font-family: var(--font-display);
    font-weight: 800;
    text-transform: uppercase;
    font-size: clamp(8rem, 26vw, 28rem);
    line-height: 0.78;
    text-align: right;
    color: transparent;
    -webkit-text-stroke: 1.5px var(--line-strong);
    pointer-events: none;
    user-select: none;
  }
  .hero__grid {
    flex: 1;
    display: grid;
    align-items: center;
    gap: 24px;
    padding-top: clamp(24px, 5vw, 56px);
  }
  .hero__copy { display: grid; gap: 28px; position: relative; z-index: 2; }
  .hero__title { display: flex; flex-direction: column; }
  .hero__line { display: block; }
  .hero__ctas { display: flex; flex-wrap: wrap; gap: 12px; }
  .hero__visual { position: relative; display: grid; place-items: center; }
  .hero__glow {
    position: absolute; inset: 10%;
    background: radial-gradient(circle, rgba(163, 176, 108, 0.28) 0%, transparent 62%);
    filter: blur(20px);
    transform: scale(1.4);
  }
  .hero__product {
    position: relative;
    width: min(100%, 680px);
    height: auto;
    filter: drop-shadow(0 50px 60px rgba(0, 0, 0, 0.35));
    will-change: transform;
  }
  .hero__foot {
    display: flex; justify-content: space-between; align-items: center;
    padding-block: 24px;
    font-family: var(--font-display); font-weight: 600; letter-spacing: 0.18em; text-transform: uppercase; font-size: 0.85rem; color: var(--ink-3);
  }
  .hero__scroll { display: inline-flex; align-items: center; gap: 12px; }
  .hero__scroll span { width: 1px; height: 36px; background: var(--line-strong); position: relative; overflow: hidden; }
  .hero__scroll span::after {
    content: ''; position: absolute; left: 0; top: 0; width: 1px; height: 40%; background: var(--accent);
    animation: drip 1.8s var(--ease) infinite;
  }
  @keyframes drip { from { transform: translateY(-100%); } to { transform: translateY(260%); } }

  @media (min-width: 1024px) {
    .hero__grid { grid-template-columns: 1.05fr 1fr; padding-top: 0; }
  }
  @media (max-width: 1023px) {
    .hero__visual { order: -1; max-width: 520px; margin-inline: auto; }
    .hero__product { width: 78%; }
  }
  @media (max-width: 520px) {
    .hero__ctas .btn { width: 100%; }
  }
</style>
