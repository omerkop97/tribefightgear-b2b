---
/**
 * Homepage hero: cinematic factory film behind the headline.
 */
import Icon from '../Icon.astro';
import { BOOKING_URL, whatsappUrl } from '../../data/site';
import { t, type Lang } from '../../i18n';

const { lang } = Astro.props as { lang: Lang };
const d = t(lang);
const lines = d.hero.title;

---
<section class="hero" data-hero>
  <div class="hero__bg" data-hero-bg aria-hidden="true">
    <video class="hero__video" autoplay muted loop playsinline preload="auto" poster="/video/hero-poster.jpg" data-loop>
      <source src="/video/hero-loop.mp4" type="video/mp4" />
    </video>
    <div class="hero__tint"></div>
    <div class="hero__shade"></div>
    <div class="hero__grain grain"></div>
  </div>

  <div class="hero__grid container">
    <div class="hero__copy">
      <span class="eyebrow" data-hero-in>{d.hero.eyebrow}</span>
      <h1 class="hero__title" data-split="load">
        {lines.map((line, i) => (
          <span class:list={['hero__line', { accent: i === lines.length - 1 }]}>{line}</span>
        ))}
      </h1>
      <p class="lead hero__lead" data-hero-in>{d.hero.body}</p>
      <div class="hero__ctas" data-hero-in>
        <a class="btn btn--primary" href={BOOKING_URL} target="_blank" rel="noopener">
          <Icon name="calendar" /> {d.cta.book}
        </a>
        <a class="btn btn--ghost btn--wa" href={whatsappUrl(d.cta.whatsappMsg)} target="_blank" rel="noopener">
          <Icon name="whatsapp" class="wa" /> {d.cta.whatsapp}
        </a>
      </div>
    </div>

  </div>

</section>

<style>
  .hero {
    position: relative;
    min-height: calc(100svh - var(--banner-h) - var(--header-h));
    display: flex;
    flex-direction: column;
    overflow: hidden;
    isolation: isolate;
  }

  /* Cinematic background */
  .hero__bg { position: absolute; inset: 0; z-index: -1; will-change: transform; }
  .hero__video { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; filter: grayscale(0.3) contrast(1.08) brightness(0.72); }
  .hero__tint { position: absolute; inset: 0; background: #4b5320; mix-blend-mode: color; opacity: 0.35; }
  .hero__shade {
    position: absolute; inset: 0;
    background:
      linear-gradient(90deg, rgba(10, 11, 8, 0.94) 0%, rgba(10, 11, 8, 0.78) 35%, rgba(10, 11, 8, 0.25) 68%, rgba(10, 11, 8, 0.15) 100%),
      linear-gradient(180deg, rgba(10, 11, 8, 0.35) 0%, transparent 25%, transparent 70%, var(--bg) 100%);
  }
  .hero__grain { position: absolute; inset: 0; }
  .hero__grain::before { opacity: 0.09; }

  .hero__grid {
    flex: 1;
    display: grid;
    align-items: center;
    gap: 32px;
    padding-block: clamp(20px, 3vh, 48px);
  }
  .hero__copy { display: grid; gap: clamp(18px, 2.6vh, 28px); position: relative; z-index: 2; }
  .hero__title { display: flex; flex-direction: column; font-size: clamp(3rem, min(6vw, 9.5vh), 6.6rem); font-weight: 800; line-height: 0.92; }
  @media (min-width: 1024px) { .hero__line { white-space: nowrap; } }
  .hero__line { display: block; }
  .hero__lead { color: rgba(238, 235, 225, 0.82); }
  .hero__ctas { display: flex; flex-wrap: wrap; gap: 12px; }
  .hero__ctas .btn--ghost { background: rgba(10, 11, 8, 0.45); backdrop-filter: blur(8px); -webkit-backdrop-filter: blur(8px); }



  @media (min-width: 1024px) {
    .hero__copy { max-width: 760px; }
    .hero { height: calc(100svh - var(--banner-h) - var(--header-h)); min-height: 640px; }
  }
  @media (max-width: 1023px) {
    .hero__shade { background: linear-gradient(180deg, rgba(10, 11, 8, 0.55) 0%, rgba(10, 11, 8, 0.75) 45%, rgba(10, 11, 8, 0.92) 70%, var(--bg) 100%); }
  }
  @media (max-width: 640px) {
    .hero__ctas .btn { width: 100%; }
      }
</style>
