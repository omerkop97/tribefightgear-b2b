---
/**
 * Listing page for a product line (/products/essential) or a category (/products/gloves).
 * Line pages filter by category, category pages filter by line.
 */
import Base from '../../../layouts/Base.astro';
import Icon from '../../../components/Icon.astro';
import PageHero from '../../../components/PageHero.astro';
import ProductGrid from '../../../components/ProductGrid.astro';
import FinalCta from '../../../components/sections/FinalCta.astro';
import { CATEGORIES, img } from '../../../data/products';
import { LINES, productsInCategory, productsInLine, type LineId } from '../../../data/shop';
import { BOOKING_URL } from '../../../data/site';
import { LANGS, DEFAULT_LANG, langFromParam, localePath, t } from '../../../i18n';

export function getStaticPaths() {
  const groups = [...LINES.map((l) => l.id as string), ...CATEGORIES.map((c) => c.id as string)];
  return LANGS.flatMap((lang) => groups.map((group) => ({ params: { lang: lang === DEFAULT_LANG ? undefined : lang, group } })));
}

const lang = langFromParam(Astro.params.lang);
const d = t(lang);
const group = Astro.params.group as string;
const line = LINES.find((l) => l.id === group);
const category = CATEGORIES.find((c) => c.id === group);

const title = line ? line.name[lang] : category!.name[lang];
const eyebrow = line ? line.tagline[lang] : d.shop.category;
const body = line ? line.body[lang] : category!.intro[lang];
const products = line ? productsInLine(line.id) : productsInCategory(category!.id);
const filters = line
  ? { key: 'category' as const, options: CATEGORIES.map((c) => ({ value: c.id, label: c.name[lang] })) }
  : { key: 'line' as const, options: LINES.map((l) => ({ value: l.id, label: l.name[lang] })) };
const otherLines = LINES.filter((l) => l.id !== group);
const lineCover = (id: LineId) => {
  const p = productsInLine(id)[0];
  return p ? img(p.category, p.slug, 1, 700) : undefined;
};
---
<Base lang={lang} path={`/products/${group}`} title={title} description={body}>
  <PageHero
    eyebrow={eyebrow}
    title={title}
    body={body}
    word={line ? line.name.en.split(' ')[0] : category!.name.en.split(' ')[0]}
    crumbs={[{ label: 'Home', href: localePath(lang, '/') }, { label: d.nav.products, href: localePath(lang, '/products') }]}
  />

  <section class="section--tight">
    <div class="container">
      {products.length > 0 ? (
        <ProductGrid products={products} lang={lang} filters={filters} />
      ) : (
        <div class="soon" data-reveal>
          <span class="eyebrow">ISPO 2026 · Stand 2E30</span>
          <h2 class="display-m">{d.shop.comingTitle}</h2>
          <p class="lead">{line?.comingSoon?.[lang]}</p>
          <a class="btn btn--primary" href={BOOKING_URL} target="_blank" rel="noopener"><Icon name="calendar" /> {d.cta.book}</a>
        </div>
      )}
    </div>
  </section>

  <section class="section--tight lines">
    <div class="container">
      <h2 class="lines__title">{line ? d.shop.otherLines : d.shop.lines}</h2>
      <div class="lines__grid">
        {(line ? otherLines : LINES).map((l) => (
          <a class:list={['lcard', `lcard--${l.id}`]} href={localePath(lang, `/products/${l.id}`)}>
            <div class="lcard__img stage">{lineCover(l.id) && <img src={lineCover(l.id)} alt="" loading="lazy" width="700" height="700" />}</div>
            <div class="lcard__body">
              <span class="lcard__name">{l.name[lang]}</span>
              <span class="lcard__tag">{l.tagline[lang]}</span>
            </div>
            <Icon name="arrow" class="lcard__arrow" />
          </a>
        ))}
      </div>
    </div>
  </section>

  <FinalCta lang={lang} />
</Base>

<style>
  .soon { display: grid; gap: 20px; justify-items: start; padding: clamp(32px, 5vw, 64px); border: 1.5px dashed var(--line-strong); }
  .lines { border-top: 1px solid var(--line); }
  .lines__title { font-size: clamp(1.4rem, 2.2vw, 1.9rem); letter-spacing: 0.06em; margin-bottom: 24px; }
  .lines__grid { display: grid; gap: 12px; }
  @media (min-width: 700px) { .lines__grid { grid-template-columns: 1fr 1fr; } }
  @media (min-width: 1100px) { .lines__grid { grid-template-columns: repeat(4, 1fr); } }
  .lcard { display: grid; grid-template-columns: 72px 1fr auto; gap: 16px; align-items: center; padding: 10px 18px 10px 10px; background: var(--surface); border: 1px solid var(--line); transition: border-color 0.3s; }
  .lcard:hover { border-color: var(--accent); }
  .lcard__img { aspect-ratio: 1; }
  .lcard__img img { padding: 10%; }
  .lcard__body { display: grid; gap: 2px; }
  .lcard__name { font-family: var(--font-display); font-weight: 700; text-transform: uppercase; font-size: 1.3rem; letter-spacing: 0.04em; }
  .lcard--elite .lcard__name { color: var(--sand); }
  .lcard__tag { font-size: 0.85rem; color: var(--ink-3); }
  .lcard :global(.lcard__arrow) { width: 18px; height: 18px; color: var(--accent); transition: transform 0.3s var(--ease); }
  .lcard:hover :global(.lcard__arrow) { transform: translateX(4px); }
</style>
