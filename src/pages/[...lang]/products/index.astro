---
import Base from '../../../layouts/Base.astro';
import PageHero from '../../../components/PageHero.astro';
import ProductGrid from '../../../components/ProductGrid.astro';
import FinalCta from '../../../components/sections/FinalCta.astro';
import { LINES, PRODUCTS } from '../../../data/shop';
import { langPaths, langFromParam, localePath, t } from '../../../i18n';

export const getStaticPaths = langPaths;
const lang = langFromParam(Astro.params.lang);
const d = t(lang);
---
<Base lang={lang} path="/products" title={d.shop.allProducts} description={d.shop.allProductsBody}>
  <PageHero
    eyebrow={d.categories.eyebrow}
    title={d.shop.allProducts}
    body={d.shop.allProductsBody}
    word="Equipment"
    crumbs={[{ label: 'Home', href: localePath(lang, '/') }]}
  />
  <section class="section--tight">
    <div class="container">
      <ProductGrid products={PRODUCTS} lang={lang} filters={{ key: 'line', options: LINES.map((l) => ({ value: l.id, label: l.name[lang] })) }} />
    </div>
  </section>
  <FinalCta lang={lang} />
</Base>
