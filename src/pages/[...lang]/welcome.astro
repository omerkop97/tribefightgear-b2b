---
/**
 * Landing page behind Bart's QR code. Drop the video in public/video/welcome.mp4
 * (and optionally a still as public/video/welcome-poster.jpg); until then a placeholder shows.
 */
import fs from 'node:fs';
import path from 'node:path';
import Base from '../../layouts/Base.astro';
import Icon from '../../components/Icon.astro';
import { CATEGORIES } from '../../data/products';
import { productsInCategory, photo } from '../../data/shop';
import { BOOKING_URL, ISPO, whatsappUrl } from '../../data/site';
import { langFromParam, langPaths, localePath, t } from '../../i18n';

export const getStaticPaths = langPaths;
const lang = langFromParam(Astro.params.lang);
const d = t(lang);
const w = d.welcome;

const pub = (f: string) => fs.existsSync(path.join(process.cwd(), 'public', f));
const hasVideo = pub('video/welcome.mp4');
const poster = pub('video/welcome-poster.jpg') ? '/video/welcome-poster.jpg' : '/video/hero-poster.jpg';

const tiles = CATEGORIES.map((c) => {
  const items = productsInCategory(c.id);
  const cover = items.find((p) => p.slug === c.cover) ?? items[0];
  return { href: localePath(lang, `/products/${c.id}`), name: c.name[lang], img: cover ? photo(cover, 1, 700) : undefined };
});
---
<Base lang={lang} path="/welcome" title={w.title} description={w.body}>
  <section class="wl">
    <div class="container wl__inner">
      <div class="wl__intro">
        <span class="eyebrow">{w.eyebrow}</span>
        <h1 class="wl__title">{w.title}</h1>
      </div>

      <div class="wl__video" data-welcome-video>
        {hasVideo ? (
          <>
            <video src="/video/welcome.mp4" poster={poster} playsinline preload="metadata" controls></video>
            <button class="wl__play" type="button" data-welcome-play aria-label={w.play}>
              <span class="wl__play-icon"><Icon name="play" /></span>
              <span>{w.play}</span>
            </button>
          </>
        ) : (
          <div class="wl__soon" style={`background-image:url(${poster})`}>
            <span class="wl__play-icon"><Icon name="play" /></span>
            <span class="wl__soon-label">{w.soon}</span>
          </div>
        )}
      </div>

      <p class="wl__body">{w.body}</p>

      <div class="wl__ctas">
        <a class="btn btn--primary" href={BOOKING_URL} target="_blank" rel="noopener"><Icon name="calendar" /> {d.cta.book}</a>
        <a class="btn btn--ghost btn--wa" href={whatsappUrl(w.whatsappMsg)} target="_blank" rel="noopener"><Icon name="whatsapp" class="wa" /> {w.whatsapp}</a>
      </div>

      <p class="wl__ispo"><Icon name="pin" /> ISPO 2026 · {ISPO.venue} · {ISPO.dates[lang]} · {d.ispo.stand} {ISPO.stand}</p>

      <div class="wl__explore">
        <h2 class="wl__h2">{w.explore}</h2>
        <div class="wl__tiles">
          {tiles.map((tile) => (
            <a class="wl__tile" href={tile.href}>
              <span class="wl__tile-img stage">{tile.img && <img src={tile.img} alt="" loading="lazy" width="700" height="700" />}</span>
              <span class="wl__tile-name">{tile.name}</span>
              <Icon name="arrow" />
            </a>
          ))}
        </div>
        <a class="link-arrow" href={localePath(lang, '/')}>{w.site} <Icon name="arrow" /></a>
      </div>
    </div>
  </section>
</Base>

<script>
  document.querySelectorAll<HTMLElement>('[data-welcome-video]').forEach((box) => {
    const video = box.querySelector('video');
    const btn = box.querySelector<HTMLButtonElement>('[data-welcome-play]');
    if (!video || !btn) return;
    btn.addEventListener('click', () => { video.play().catch(() => {}); });
    video.addEventListener('play', () => box.classList.add('is-playing'));
  });
</script>

<style>
  .wl { padding-block: clamp(20px, 4vw, 56px) clamp(56px, 8vw, 96px); }
  .wl__inner { display: grid; gap: 22px; max-width: 880px; }
  .wl__intro { display: grid; gap: 10px; }
  .wl__title { font-size: clamp(2.4rem, 7vw, 4.6rem); font-weight: 800; line-height: 0.92; }

  .wl__video { position: relative; aspect-ratio: 16 / 9; background: #000; border: 1px solid var(--line); overflow: hidden; }
  .wl__video video { width: 100%; height: 100%; object-fit: contain; display: block; }
  .wl__play {
    position: absolute; inset: 0; display: grid; place-content: center; justify-items: center; gap: 14px;
    background: linear-gradient(180deg, rgba(10, 11, 8, 0.15), rgba(10, 11, 8, 0.6));
    font-family: var(--font-display); font-weight: 700; letter-spacing: 0.12em; text-transform: uppercase; color: #eeebe1;
    transition: opacity 0.3s;
  }
  .wl__video:global(.is-playing) .wl__play { opacity: 0; pointer-events: none; }
  .wl__play-icon { width: 84px; height: 84px; border-radius: 50%; display: grid; place-items: center; background: var(--accent-fill); color: var(--on-accent); box-shadow: 0 0 0 12px rgba(75, 83, 32, 0.35); }
  .wl__play-icon :global(svg) { width: 30px; height: 30px; margin-left: 4px; }
  .wl__soon { position: absolute; inset: 0; display: grid; place-content: center; justify-items: center; gap: 14px; background-size: cover; background-position: center; }
  .wl__soon::before { content: ''; position: absolute; inset: 0; background: rgba(10, 11, 8, 0.72); }
  .wl__soon > * { position: relative; }
  .wl__soon-label { font-family: var(--font-display); font-weight: 600; letter-spacing: 0.16em; text-transform: uppercase; color: var(--ink-2); }

  .wl__body { font-size: clamp(1.05rem, 1.6vw, 1.2rem); color: var(--ink-2); max-width: 60ch; }
  .wl__ctas { display: flex; flex-wrap: wrap; gap: 12px; }
  .wl__ispo { display: flex; align-items: center; gap: 10px; font-family: var(--font-display); font-weight: 600; letter-spacing: 0.1em; text-transform: uppercase; font-size: 0.9rem; color: var(--ink-3); }
  .wl__ispo :global(svg) { width: 18px; height: 18px; color: var(--accent); flex: none; }

  .wl__explore { display: grid; gap: 16px; margin-top: 16px; padding-top: 28px; border-top: 1px solid var(--line); }
  .wl__h2 { font-size: clamp(1.5rem, 3vw, 2rem); }
  .wl__tiles { display: grid; gap: 10px; }
  @media (min-width: 640px) { .wl__tiles { grid-template-columns: 1fr 1fr; } }
  .wl__tile { display: grid; grid-template-columns: 64px 1fr auto; align-items: center; gap: 16px; padding: 8px 16px 8px 8px; background: var(--surface); border: 1px solid var(--line); transition: border-color 0.3s; }
  .wl__tile:hover { border-color: var(--accent); }
  .wl__tile-img { aspect-ratio: 1; }
  .wl__tile-img img { padding: 10%; }
  .wl__tile-name { font-family: var(--font-display); font-weight: 700; text-transform: uppercase; letter-spacing: 0.04em; font-size: 1.15rem; }
  .wl__tile > :global(svg) { width: 18px; height: 18px; color: var(--accent); }
  @media (max-width: 520px) { .wl__ctas .btn { width: 100%; } }
</style>
